# Keep the build context small + deterministic.
.git
.gitignore
**/__pycache__/
**/*.py[cod]

# Local envs. `**/` matters: a bare `.venv/` matches only the context root, and
# the venv this project actually tells you to build lives at backend/.venv (see
# the README quickstart) -- so without the glob it went into the build context,
# all 600 MB of it.
**/.venv/
**/venv/
**/env/

# Local media + artifacts (model is fetched in the Dockerfile; uploads are runtime)
*.mp4
*.MP4
*.mov
*.MOV
*.avi
backend/uploads/
backend/models/*.task
*.log

# The landing page's video and screenshots are part of the app and must ship
# with it. The *.mp4 / *.MOV rules above are aimed at stray clips lying around
# the repo root; spell the exception out rather than trusting that they don't
# reach nested paths.
!backend/app/static/media
!backend/app/static/media/**

# Source material the landing assets were derived from (multi-MB saved pages and
# full-size originals). The shipped, compressed versions are under
# backend/app/static/media -- see backend/scripts/make_before_bw.py.
compare/

# Not needed in the image
node_modules/
brandbook-v2.html
DEPLOY.md
README.md
