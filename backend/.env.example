# Copy to .env (git-ignored) or set these as real environment variables.

# LLM coaching (Milestone 5). Google AI Studio key. If unset, the app still
# works — it just skips the AI recommendations.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional path overrides
# VA_MODELS_DIR=
# VA_UPLOADS_DIR=

# Optional CORS lock-down for production (comma-separated origins; default *)
# VA_CORS_ORIGINS=https://your-frontend.example

# Abuse guard: analyses per client IP per rolling 24h (default 3; 0 disables)
# VA_RATE_LIMIT_PER_DAY=3

# --- Accounts / billing ---
# Postgres URL in prod (Railway); defaults to a local SQLite file if unset.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# MUST be overridden in prod (any long random string).
# JWT_SECRET=change-me-to-a-long-random-string
# Account auto-promoted to the admin tier (5 analyses/day) on startup.
# ADMIN_EMAIL=you@example.com

# --- Billing (Stripe, Stage 4) ---
# When STRIPE_SECRET_KEY is unset, /billing/* return 503 and the frontend shows
# a "coming soon" message. Secret keys MUST stay in the environment (never git).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from the webhook endpoint you create
# Price IDs (not secret; differ between test and live mode). Amounts must match
# the display catalogue in app/services/pricing.py -- Stripe is what charges,
# pricing.py is what the customer reads. All prices are created in USD.
# STRIPE_PRICE_ENTHUSIAST_M=price_...      # $9 / month
# STRIPE_PRICE_ENTHUSIAST_Y=price_...      # $69 / year
# STRIPE_PRICE_FULL_Y=price_...            # $99 / year
# STRIPE_PRICE_EXPERT=price_...            # $39 one-time
# STRIPE_PRICE_UNLOCK=price_...            # $4 one-time
# How many Expert Reviews may be taken on in a rolling week. The deliverable is
# ~40 minutes of a person's attention; this is what stops the queue growing
# past what that person can actually write. 0 disables the check.
# EXPERT_REVIEW_SLOTS_PER_WEEK=5
# Absolute URL for Checkout redirects (falls back to request origin if unset):
# PUBLIC_BASE_URL=https://your-domain.example

# --- Notifications (services/notify.py). Optional: with none of this set, a
# delivered Expert Review is only discoverable inside the app -- the athlete is
# never told it landed. The startup log says which of the two it is.
# Provider: "resend" (one HTTPS POST, recommended) or "smtp" (anything else).
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_...                     # resend only; needs Sending access
# From: address. MUST be on a domain verified with the provider, or the send is
# rejected outright. Resend recommends a SUBDOMAIN, so the marketing domain's
# reputation and the app's are not the same thing:
# EMAIL_FROM=Flapp <reviews@mail.getflapp.com>
# Where replies to a "your review is ready" mail land. Omit and there is no
# Reply-To header at all, so replies go to EMAIL_FROM -- which nobody reads.
# EMAIL_REPLY_TO=artur@getflapp.com
# Needed for the link in the mail; without it the URL is guessed from headers:
# PUBLIC_BASE_URL=https://video-analysis-production-1f54.up.railway.app
#
# Verify the whole chain without faking an order (admin tier):
#   curl -X POST $BASE/admin/email-test -H "Authorization: Bearer $TOKEN"
# --- smtp only (Fastmail, Gmail app password, SES SMTP, ...) ---
# SMTP_HOST=
# SMTP_PORT=587                            # STARTTLS; 25 is blocked on most hosts
# SMTP_USER=
# SMTP_PASSWORD=
